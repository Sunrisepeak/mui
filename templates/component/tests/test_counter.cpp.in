// The component as an agent and a person meet it: by its role, its name, its actions.
import std;
import openmui;
import {{project.name}};

int main() {
    omui::Headless h({.size = {200, 100}});
    auto value = omui::signal(std::int32_t{3});
    h.mount("main", omui::column({.padding = 8}, { {{project.name}}::counter({.id = "n", .label = "Copies", .value = value}) }));
    h.settle();
    auto n = h.tree().node("main/n");
    if (!n || n->role != omui::Role::spin_button || n->name != "Copies") return 1;
    if (h.tree().act("main/n", "increment").exit_code() != std::optional<int>(0) || value.peek() != 4) return 1;
    // Undone by the window's history; a dry run changes nothing.
    if (h.tree().act("app", "undo").exit_code() != std::optional<int>(0) || value.peek() != 3) return 1;
    omui::Invocation dry;
    dry.dry_run = true;
    if (h.tree().act("main/n", "increment", dry).exit_code() != std::optional<int>(0) || value.peek() != 3) return 1;
    h.focus_next();
    h.key(omui::Key::down);
    return value.peek() == 2 ? 0 : 1;
}

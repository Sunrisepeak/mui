// The stage's contract becomes code, and the fighters' files — what they do
// and how they look — are carried in the program (openmui.rules).
import std;
import mcpp;
import openmui.rules;

int main() {
    const bool stage = openmui::rules::components({.module = "openmui.showcase.fighting", .ns = "omui::fighting"});
    const bool fighters = openmui::rules::embed(
        {.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "fighters", .suffix = ".fighter.gongfu.toml", .tag = "fighter"});
    const bool looks = openmui::rules::embed(
        {.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "fighters", .suffix = ".look.gongfu.toml", .tag = "look"});
    return stage && fighters && looks ? 0 : 1;
}

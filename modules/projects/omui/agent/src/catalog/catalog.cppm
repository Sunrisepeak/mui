    {{"ui.input", openas::Effect::reversible, false}, "A person's input as their devices give it (pointer, keys, text), delivered a frame at a time; answers what each press hit", parameters_ui_input, "json", mlibs::control::Cost::heavy, "what the input performed is the actions' own (ui.undo for reversible ones)", false, false, false, examples_ui_input, "", then_ui_input},
    {{"ui.intend", openas::Effect::read, false}, "Say to the person what you are about to do (the steps, or a note) — or, handing the task back, what you did, what is left, what you were unsure of: shown by your presence until you say another; nothing in the application changes", parameters_ui_intend, "json", mlibs::control::Cost::instant, "", false, false, false, examples_ui_intend},
    {{"ui.claim", openas::Effect::reversible, false}, "Hold a part of the interface while you design it (D-160), so another agent's change there is refused (conflict: who holds it, what for, retry_after) — a node itself, one of its properties, or the node and everything inside it; as small as the work. Shown with your presence; claiming it again renews it; the person is never held, and taking over releases every claim", parameters_ui_claim, "json", mlibs::control::Cost::instant, "ui.release", false, false, false, examples_ui_claim},
    {{"ui.release", openas::Effect::reversible, false}, "Let go of a part you hold (ui.claim): another may claim and change it", parameters_ui_release, "json", mlibs::control::Cost::instant, "ui.claim", false, false, false, examples_ui_release},
    {{"ui.claims", openas::Effect::read, false}, "Every part held now (D-160): the node, the property, whether inside it too, who holds it, what for, and for how long", {}, "json", mlibs::control::Cost::instant, "", false, false, false, {}},
    {{"ui.timeline", openas::Effect::read, false}, "What input did, oldest first: each input event's records — what it hit, what stopped it (disabled, outside, nothing to press, refused), what it activated — at the recorder's level; and what was done (`actions`): every action with who did it, whatever led to it — a press, or an agent's request — kept at every level. The person's own input and actions, outside development, once they say yes (answer)", parameters_ui_timeline, "json", mlibs::control::Cost::instant, "", false, false, false, examples_ui_timeline},
    {{"ui.explain", openas::Effect::read, false}, "A press and what came of it, from press to release: what it hit, what stopped it, the actions it led to, and a sentence saying what happened. A press of the person's, outside development, once they say yes (answer)", parameters_ui_explain, "json", mlibs::control::Cost::instant, "", false, false, false, {}},
    {{"ui.drew", openas::Effect::read, false}, "What drew a pixel: the node its colour came from, the nodes it sits in, and where in the program each was built; where the node shows something drawn elsewhere (a world in a viewport), `shows`: its subject, the place in its picture and what is there", parameters_ui_drew, "json", mlibs::control::Cost::instant, "", false, false, false, examples_ui_drew},
    {{"ui.inspect", openas::Effect::read, false}, "A node's layout, style, state, bindings and motion, for development", parameters_ui_inspect, "json", mlibs::control::Cost::instant, "", false, false, false, {}},
    {{"ui.stats", openas::Effect::read, false}, "Frame times (mean, percentiles, phases) and the last frame's counts", parameters_ui_stats, "json", mlibs::control::Cost::instant, "", false, false, false, {}},
    {{"ui.profile", openas::Effect::reversible, false}, "Start or stop recording a trace; stopping answers its summary (and Chrome's format)", parameters_ui_profile, "json", mlibs::control::Cost::instant, "the other action", false, false, false, examples_ui_profile},

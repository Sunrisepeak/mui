// openmui.i18n.cldr — CLDR's locale data for openmui.i18n, carried in the
// program (generated by `omui-gen cldr`, CLDR 49).
//
//     mlibs::i18n::Library lib;
//     mlibs::i18n::cldr::add_to(lib);     // en, zh, zh-Hant and the likely subtags
export module mlibs.i18n.cldr.api;

export import :en_locale;
export import :zh_locale;
export import :zh_Hant_locale;
export import :likely_locale;

import std;
import mlibs.i18n;

export namespace mlibs::i18n::cldr {

inline constexpr std::string_view version = "49.0.0";
// The packs' CLDR ids: zh is Simplified Chinese (CLDR's default content).
inline constexpr std::array<std::string_view, 3> locales{"en", "zh", "zh-Hant"};

// A pack, read once and shared; nothing for an id not packed.
[[nodiscard]] std::shared_ptr<const LocaleData> data(std::string_view id);
[[nodiscard]] const LikelySubtags& likely();

// Every pack and the likely subtags, into a library.
void add_to(Library& library);

}  // namespace mlibs::i18n::cldr

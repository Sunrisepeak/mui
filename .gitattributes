# Every text file is LF in every checkout, Windows included: generated files
# are compared byte for byte with what omui-gen writes (tools/gen tests), and
# data files are hashed.
* text=auto eol=lf

# Binary: never converted.
*.ttf  binary
*.otf  binary
*.png  binary
*.jpg  binary
*.webp binary
*.ico  binary
# Upstream conformance suites: kept exactly as published (their checksums are
# in modules/markdown/tests/data/README.md).
modules/markdown/tests/data/*.txt -text

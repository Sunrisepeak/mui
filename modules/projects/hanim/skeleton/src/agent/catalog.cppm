    {{"skeleton.set", openas::Effect::reversible, false}, "Sets a parameter of a character's machine (a trigger: 1); its transitions read it from the next step", parameters_skeleton_set, "json", mlibs::control::Cost::bounded, "skeleton.seek to the frame it was given at", false, false, false, examples_skeleton_set},
    {{"skeleton.blend", openas::Effect::reversible, false}, "Layers a clip over what the machine plays: mixed in by a weight (on a joint's subtree when a mask is given) or added (its difference from its own start); a weight of 0 takes the layer away", parameters_skeleton_blend, "json", mlibs::control::Cost::bounded, "skeleton.blend with weight 0, or skeleton.seek", false, false, false, examples_skeleton_blend},
    {{"skeleton.joint", openas::Effect::read, false}, "Where a joint is: in the world (the character's place, then the joint in the model's space), its turn and its place relative to the model", parameters_skeleton_joint, "json", mlibs::control::Cost::instant, "", false, false, false, examples_skeleton_joint},
    {{"skeleton.sample", openas::Effect::read, false}, "Any clip at any time, as a pure function of it: a joint's place in the model (or every joint's, within a budget), the root motion from the clip's start, and the error compression left there", parameters_skeleton_sample, "json", mlibs::control::Cost::instant, "", false, false, false, examples_skeleton_sample},
    {{"skeleton.step", openas::Effect::reversible, false}, "Steps every character (1/60 s a step): machines choose, clips play, root motion carries them", parameters_skeleton_step, "json", mlibs::control::Cost::bounded, "skeleton.seek to the frame it began at", false, false, false, examples_skeleton_step, "", then_skeleton_step},
    {{"skeleton.seek", openas::Effect::reversible, false}, "Returns to a frame within the history kept, bit for bit (a checkpoint and the inputs since, given again); what is stepped from there is a new branch", parameters_skeleton_seek, "json", mlibs::control::Cost::bounded, "none within the world: what came after the frame is another branch's", false, false, false, examples_skeleton_seek, "", then_skeleton_seek},

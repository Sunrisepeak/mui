// The GPU backend's shaders become partitions of openmui.render, for the
// formats this build's target takes: shaders/<name>.slang (drawing,
// compositing) and effects/<name>.slang (the built-in effects' GPU paths,
// written against the effect template in effects/lib) as :<name>_shaders.
import std;
import mcpp;
import openmui.shader.rules;

int main() {
    const bool drawing = openmui::shader::rules::shaders({.module = "openmui.render", .ns = "omui::render::shaders"});
    const bool effects = openmui::shader::rules::shaders(
        {.module = "openmui.render", .ns = "omui::render::shaders", .shaders = "effects", .includes = {"effects/lib"}});
    return drawing && effects ? 0 : 1;
}

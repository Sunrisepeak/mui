     "then": [{"why": "read what changed in the tree, without reading it all again", "request": {"op":"ui.changes"}}],
     "examples": [{"op":"ui.act","node":"main/save","action":"activate"}],
     "inputSchema": {"type": "object", "properties": {"node": {"type": "string", "description": "a node (its id)"}, "action": {"type": "string", "description": "one of the node's actions (activate, toggle, set_value, …)"}, "args": {"description": "the action's arguments"}, "answer": {"type": "string", "description": "the person's answer, when the action asks"}, "dry_run": {"type": "boolean", "description": "only say what would happen"}}, "required": ["node", "action"]}},
    {"name": "ui.invoke", "description": "Call one of the application's verbs, under its declared effect", "effect": "irreversible", "person": false, "delegated": true, "cost": "bounded", "undo": "the verb's own (an undoable verb: ui.undo)", "undoable": false, "cancellable": false, "result": "json",
     "then": [{"why": "read what changed in the tree, without reading it all again", "request": {"op":"ui.changes"}}],
     "examples": [{"op":"ui.invoke","verb":"save"}],
     "inputSchema": {"type": "object", "properties": {"verb": {"type": "string", "description": "a verb ui.describe lists"}, "args": {"description": "its arguments"}, "answer": {"type": "string", "description": "the person's answer, when the verb asks"}, "dry_run": {"type": "boolean", "description": "only say what would happen"}}, "required": ["verb"]}},
    {"name": "ui.undo", "description": "Take back the last change in a history scope", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "ui.redo", "undoable": false, "cancellable": false, "result": "json",
     "then": [{"why": "read what changed in the tree, without reading it all again", "request": {"op":"ui.changes"}}],
     "inputSchema": {"type": "object", "properties": {"scope": {"type": "string", "description": "a node (its id): a node's undo scope (the window's when absent)"}}, "required": []}},
    {"name": "ui.redo", "description": "Do again what ui.undo took back", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "ui.undo", "undoable": false, "cancellable": false, "result": "json",
     "then": [{"why": "read what changed in the tree, without reading it all again", "request": {"op":"ui.changes"}}],
     "inputSchema": {"type": "object", "properties": {"scope": {"type": "string", "description": "a node (its id)"}}, "required": []}},
    {"name": "ui.transaction", "description": "Steps performed as one: all done, or all taken back", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "ui.undo takes the whole transaction back", "undoable": false, "cancellable": false, "result": "json",
     "then": [{"why": "read what changed in the tree, without reading it all again", "request": {"op":"ui.changes"}}],
     "examples": [{"op":"ui.transaction","steps":[{"node":"main/name","action":"set_value","args":{"value":"Ada"}}]}],
     "inputSchema": {"type": "object", "properties": {"steps": {"description": "a list of {node, action, args, answer}"}, "label": {"type": "string", "description": "what the history calls it"}}, "required": ["steps"]}},
    {"name": "ui.preview", "description": "What steps would make, shown before it is allowed: pictures before and after, the semantic changes; nothing stays", "effect": "read", "person": false, "delegated": false, "cost": "bounded", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "examples": [{"op":"ui.preview","steps":[{"node":"main/dark","action":"toggle"}],"pictures":false}],
     "inputSchema": {"type": "object", "properties": {"steps": {"description": "a list of {node, action, args}"}, "pictures": {"type": "boolean", "description": "with the pictures (default: when the host renders)"}}, "required": ["steps"]}},
    {"name": "ui.history", "description": "A history scope's changes, what can be undone and redone", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "examples": [{"op":"ui.history"}],
     "inputSchema": {"type": "object", "properties": {"scope": {"type": "string", "description": "a node (its id)"}}, "required": []}},
    {"name": "ui.state", "description": "What a person has set in the interface, by semantic id: the values of what takes one, what is checked, where the focus is (not a password) — for another instance to take back (ui.restore)", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {}, "required": []}},
    {"name": "ui.restore", "description": "ui.state's values put back where the same id with the same role takes them (a new build, a restart): what was restored, what is not there any more, what could not be; not a step of the history", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "ui.restore with the state before", "undoable": false, "cancellable": false, "result": "json",
     "examples": [{"op":"ui.restore","state":{"values":[]}}],
     "inputSchema": {"type": "object", "properties": {"state": {"description": "what ui.state answered"}}, "required": ["state"]}},
    {"name": "ui.wait", "description": "Answer when a condition holds: a node present or absent, the tree settled", "effect": "read", "person": false, "delegated": false, "cost": "heavy", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"q": {"description": "a query that must match"}, "absent": {"description": "a query that must not match"}, "settled": {"type": "boolean", "description": "no animation or layout pending"}, "timeout": {"type": "number", "description": "seconds"}}, "required": []}},
    {"name": "ui.capture", "description": "The picture as drawn: the window, a node, or a region of it, as PNG pixels or as SVG with every node's drawing marked", "effect": "read", "person": false, "delegated": false, "cost": "frame", "undo": "", "undoable": false, "cancellable": false, "result": "image",
     "inputSchema": {"type": "object", "properties": {"node": {"type": "string", "description": "a node (its id)"}, "region": {"description": "[x, y, width, height] from the node's corner, in logical pixels"}, "format": {"type": "string", "description": "png (pixels, the default) or svg (vectors at any size; each node's drawing a group marked data-node with its path; what SVG cannot say kept as pixels, listed in `islands`)"}}, "required": []}},
    {"name": "ui.input", "description": "A person's input as their devices give it (pointer, keys, text), delivered a frame at a time; answers what each press hit", "effect": "reversible", "person": false, "delegated": false, "cost": "heavy", "undo": "what the input performed is the actions' own (ui.undo for reversible ones)", "undoable": false, "cancellable": false, "result": "json",
     "then": [{"why": "read what changed in the tree, without reading it all again", "request": {"op":"ui.changes"}}],
     "examples": [{"op":"ui.input","events":[{"type":"click","at":[24,24]}]}],
     "inputSchema": {"type": "object", "properties": {"events": {"description": "a list of {type: move, click, drag, wheel, key, keys, text, wait, …}"}}, "required": ["events"]}},
    {"name": "ui.intend", "description": "Say to the person what you are about to do (the steps, or a note) — or, handing the task back, what you did, what is left, what you were unsure of: shown by your presence until you say another; nothing in the application changes", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "examples": [{"op":"ui.intend","text":"filling in the form"}],
     "inputSchema": {"type": "object", "properties": {"text": {"type": "string", "description": "the intent or the handoff's summary (\"\" withdraws it)"}, "node": {"type": "string", "description": "the node it is about"}, "hands_back": {"type": "boolean", "description": "a handoff to the person, not an intent"}}, "required": ["text"]}},
    {"name": "ui.claim", "description": "Hold a part of the interface while you design it (D-160), so another agent's change there is refused (conflict: who holds it, what for, retry_after) — a node itself, one of its properties, or the node and everything inside it; as small as the work. Shown with your presence; claiming it again renews it; the person is never held, and taking over releases every claim", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "ui.release", "undoable": false, "cancellable": false, "result": "json",
     "examples": [{"op":"ui.claim","node":"main/name"}],
     "inputSchema": {"type": "object", "properties": {"node": {"type": "string", "description": "the node's path"}, "property": {"type": "string", "description": "only this property of it"}, "subtree": {"type": "boolean", "description": "and everything inside it"}, "intent": {"type": "string", "description": "what you are doing there (others are told it)"}, "seconds": {"type": "number", "description": "seconds: the lease (30; 1 to 600): claim again before it ends"}}, "required": ["node"]}},
    {"name": "ui.release", "description": "Let go of a part you hold (ui.claim): another may claim and change it", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "ui.claim", "undoable": false, "cancellable": false, "result": "json",
     "examples": [{"op":"ui.release","node":"main/name"}],
     "inputSchema": {"type": "object", "properties": {"node": {"type": "string", "description": "the node's path, as claimed"}, "property": {"type": "string", "description": "the property, as claimed"}}, "required": ["node"]}},
    {"name": "ui.claims", "description": "Every part held now (D-160): the node, the property, whether inside it too, who holds it, what for, and for how long", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {}, "required": []}},
    {"name": "ui.timeline", "description": "What input did, oldest first: each input event's records — what it hit, what stopped it (disabled, outside, nothing to press, refused), what it activated — at the recorder's level; and what was done (`actions`): every action with who did it, whatever led to it — a press, or an agent's request — kept at every level. The person's own input and actions, outside development, once they say yes (answer)", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "examples": [{"op":"ui.timeline"}],
     "inputSchema": {"type": "object", "properties": {"since": {"type": "integer", "description": "only after this cause (an input event's number)"}, "after": {"type": "integer", "description": "only actions after this one (an action's id)"}, "limit": {"type": "integer", "description": "the last this many records, and actions (200)"}}, "required": []}},
    {"name": "ui.explain", "description": "A press and what came of it, from press to release: what it hit, what stopped it, the actions it led to, and a sentence saying what happened. A press of the person's, outside development, once they say yes (answer)", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"at": {"description": "[x, y]: the last press within a few pixels of it"}, "cause": {"type": "integer", "description": "or the press by its number (timeline)"}}, "required": []}},
    {"name": "ui.drew", "description": "What drew a pixel: the node its colour came from, the nodes it sits in, and where in the program each was built; where the node shows something drawn elsewhere (a world in a viewport), `shows`: its subject, the place in its picture and what is there", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "examples": [{"op":"ui.drew","at":[24,24]}],
     "inputSchema": {"type": "object", "properties": {"at": {"description": "[x, y] in logical pixels"}}, "required": ["at"]}},
    {"name": "ui.inspect", "description": "A node's layout, style, state, bindings and motion, for development", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"node": {"type": "string", "description": "a node (its id)"}}, "required": []}},
    {"name": "ui.stats", "description": "Frame times (mean, percentiles, phases) and the last frame's counts", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"history": {"type": "integer", "description": "the last frames, oldest first (up to 240)"}}, "required": []}},
    {"name": "ui.profile", "description": "Start or stop recording a trace; stopping answers its summary (and Chrome's format)", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "the other action", "undoable": false, "cancellable": false, "result": "json",
     "examples": [{"op":"ui.profile","action":"start"}],
     "inputSchema": {"type": "object", "properties": {"action": {"type": "string", "description": "start or stop"}, "chrome": {"type": "boolean"}}, "required": ["action"]}},
    {"name": "ui.logs", "description": "Recent log records, by level and category", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"level": {"type": "string", "description": "trace, debug, info, warning or error"}, "category": {"type": "string"}, "limit": {"type": "integer"}}, "required": []}},
    {"name": "ui.debug", "description": "Debug overlays (bounds, repaints, inspector, HUD), the slow-frame threshold and the log filter", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "ui.debug with the values it answered before", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"bounds": {"type": "boolean"}, "repaints": {"type": "boolean"}, "inspector": {"type": "boolean"}, "hud": {"type": "boolean"}, "slow_frame_ms": {"type": "number"}, "log": {"type": "string", "description": "a filter: layout=debug,*=info"}}, "required": []}},
    {"name": "ui.pipeline", "description": "The frame's pipeline: show it (a read), or replace, insert or remove one stage between frames", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "the opposite change: the stage as show read it", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"action": {"type": "string", "description": "show (the default), replace, insert or remove"}, "stage": {"type": "string"}, "plugin": {"type": "string"}, "after": {"description": "the stages it follows (insert)"}, "config": {}}, "required": []}},
    {"name": "ui.clock", "description": "The application's time: show it (a read), or pause, resume, rate, step, seek and release", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "release gives the time back to the host", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"action": {"type": "string", "description": "show (the default), pause, resume, rate, step, seek or release"}, "rate": {"type": "number"}, "seconds": {"type": "number", "description": "seconds: step by, or seek to"}}, "required": []}}
  ],
  "tiers": [],
  "tasks": [
    {"name": "see-what-is-here", "summary": "Read what the application is and can do, then the nodes a person or an agent can act on: each one's path is what `ui.act` takes as `node`", "steps": [
      {"op":"ui.describe"},
      {"op":"ui.snapshot","interactive":true}
    ]},
    {"name": "find-a-node", "summary": "Find nodes by role or name instead of reading the whole tree", "steps": [
      {"op":"ui.find","q":{"role":"button"}}
    ]},
    {"name": "ask-what-happened", "summary": "Read what was done here and by whom, then the steps that can be taken back", "steps": [
      {"op":"ui.timeline"},
      {"op":"ui.history"}
    ]},
    {"name": "read-what-changed", "summary": "After acting, read the changes alone instead of the whole tree again", "steps": [
      {"op":"ui.snapshot","depth":1},
      {"op":"ui.changes"}
    ]}
  ]
}
)listing";

}  // namespace omui::agent

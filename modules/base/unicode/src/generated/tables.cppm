[[nodiscard]] constexpr std::uint8_t lookup(const auto& stage1, const auto& stage2, char32_t cp) noexcept {
    if (cp >= 0x110000) cp = 0xFFFD;
    return stage2[static_cast<std::size_t>(stage1[cp >> 8]) * 256 + (cp & 255)];
}


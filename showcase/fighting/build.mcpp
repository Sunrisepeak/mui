// The stage's contract becomes code (openmui.build.contracts), and the fighters' files —
// what they do, how they look, their baked hurtboxes — are carried in the
// program (gongfu.rules).
import std;
import mcpp;
import openmui.build.contracts;
import openmui.build.embed;
import openmui.build.toy;
import gongfu.rules;

int main() {
    // The arenas (feature `arenas`, on by default): the stages and their
    // layers, their music, the announcer. Left out, their tables are empty —
    // training's plain room needs none (the site's move list).
    const bool arenas = mcpp::has_feature("arenas");
    const bool stage = openmui::build::components({.module = "openmui.showcase.fighting", .ns = "omui::fighting"});
    // The fighters, their looks and baked hurtboxes; a stale bake fails the build.
    const bool fighters = gongfu::rules::fighters({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files"});
    // What the fight sounds like (openmui.audio).
    const bool sounds = openmui::build::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "sounds",
                                               .suffix = ".sound.omui.toml", .tag = "sound"});
    // The stages' art (gongfu.present2d's stage files).
    const bool stages = openmui::build::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "stages",
                                               .suffix = ".stage.gongfu.toml", .tag = "stage", .index = true, .left_out = !arenas});
    // Their painted layers (the pictures the stage files name).
    const bool stage_art = openmui::build::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "stages/art",
                                                  .suffix = ".webp", .tag = "stage_art", .index = true, .left_out = !arenas});
    // The fighters' drawn art (pictures their looks' image parts are cut from).
    const bool art = openmui::build::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "fighters/art",
                                            .suffix = ".webp", .tag = "art", .index = true});
    // The HUD's art: its frames, its lettering, the names' calligraphy, its fills.
    const bool hud = openmui::build::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "hud",
                                            .suffix = ".webp", .tag = "hud", .index = true});
    // The stages' music (openmui.audio's pieces).
    const bool music = openmui::build::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "music",
                                              .suffix = ".music.omui.toml", .tag = "music", .index = true, .left_out = !arenas});
    // The announcer's recordings (voice/*.wav, Kenney's CC0 Voiceover Pack: Fighter).
    const bool voice = openmui::build::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "voice",
                                              .suffix = ".wav", .tag = "voice", .index = true, .left_out = !arenas});
    // What a gamepad's buttons do (controls/*.controls.omui.json): data, so it can be remapped.
    const bool controls = openmui::build::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "controls",
                                                 .suffix = ".controls.omui.json", .tag = "controls"});
    // On the Web, a Bilibili Toy package (D-84 §8.9): mcpp pack --target wasm32-emscripten --pkg-format dist-toy.
    const bool toy = openmui::build::dist_toy({.target = "omui-fight", .title = "格斗游戏", .fonts = {"Inter", "NotoSansSC"}, .background = "#0b0d12"});
    return stage && fighters && sounds && stages && stage_art && art && hud && music && voice && controls && toy ? 0 : 1;
}

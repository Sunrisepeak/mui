    OmuiString answer;
};

using PFN_omuiSink = void (*)(void* user, const char* data, std::size_t size);
using PFN_omuiEvent = void (*)(void* user, OmuiNode node, OmuiString event, OmuiString args_json);
using PFN_omuiVerb = OmuiResult (*)(void* user, OmuiString args_json, PFN_omuiSink sink, void* sink_user);
using PFN_omuiTask = void (*)(void* user);
using PFN_omuiChange = void (*)(void* user, OmuiSignal signal, OmuiString value_json);


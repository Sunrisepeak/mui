[package]
namespace = "mlibs.validation"
name = "rules_consumer"
version = "0.1.0"
license = "Apache-2.0"

[targets.rules-consumer]
kind = "bin"
main = "src/main.cpp"

[build]
sources = ["src/*.cpp", "src/*.cppm"]

[dependencies]
mlibs.rhi = { path = {{rhi_path}} }

[build-dependencies]
{{dependencies}}

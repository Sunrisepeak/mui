// Resolve the build profile once, in the build program. Runtime policy does
// not infer deployment mode from NDEBUG or accept a remote caller's claim.
import std;
import mcpp;

namespace {
std::string utf8(const std::filesystem::path& path) {
    const auto text = path.generic_u8string();
    return {reinterpret_cast<const char*>(text.data()), text.size()};
}
std::string literal(std::string_view text) {
    std::string out = "\"";
    for (char c : text) {
        switch (c) {
        case '\\':
            out += "\\\\";
            break;
        case '"':
            out += "\\\"";
            break;
        case '\n':
            out += "\\n";
            break;
        case '\r':
            out += "\\r";
            break;
        case '\t':
            out += "\\t";
            break;
        default:
            out += c;
            break;
        }
    }
    return out + '"';
}

// Writes a generated unit when its text changed, and hands it to the build.
bool write(const std::filesystem::path& file, const std::string& text, std::string_view what) {
    std::string old;
    if (std::ifstream input(file, std::ios::binary); input) old.assign(std::istreambuf_iterator<char>(input), {});
    if (old != text) {
        std::ofstream output(file, std::ios::binary | std::ios::trunc);
        output << text;
        if (!output) {
            std::println(std::cerr, "could not write {}", what);
            return false;
        }
    }
    mcpp::generated(utf8(file).c_str());
    return true;
}

// The services `omui::run` installs before a host is made (`hosting::install_services`): the platform's
// accessibility service where the feature asks for it and the target is a desktop (the package is a
// dependency there alone). A program built without it names nothing of the bridge, so the linker leaves
// AccessKit out.
std::string services_unit() {
    const std::string_view os = mcpp::target_os();
    const std::string_view env = mcpp::target_env();
    const bool desktop = os != "emscripten" && env != "android";
    const bool bridge = desktop && mcpp::has_feature("accessibility-bridge");
    std::string text = "// Generated by omui's build.mcpp.\nmodule omui;\n\n";
    if (bridge) text += "import omui.accessibility.bridge;\n";
    text += "import :shown;\n\nnamespace omui::hosting {\n\n";
    text += bridge ? "void install_services() { accessibility::bridge::install(); }\n" : "void install_services() {}\n";
    return text + "\n}  // namespace omui::hosting\n";
}
} // namespace

int main() {
    mcpp::rerun_if_env_changed("MCPP_PROFILE");
    mcpp::rerun_if_env_changed("MCPP_FEATURE_ACCESSIBILITY_BRIDGE");
    mcpp::rerun_if_env_changed("MCPP_TARGET_OS");
    mcpp::rerun_if_env_changed("MCPP_TARGET_ENV");
    const auto file = std::filesystem::path(mcpp::out_dir()) / "omui" / "build_profile.cppm";
    std::error_code error;
    std::filesystem::create_directories(file.parent_path(), error);
    if (error) {
        std::println(std::cerr, "{}", error.message());
        return 1;
    }
    if (!write(file.parent_path() / "services.cpp", services_unit(), "the services unit")) return 1;
    const auto text = std::format("// Generated by omui's build.mcpp.\nexport module omui:build_profile;\n\nimport std;\n\n"
                                  "export namespace omui::build {{\ninline constexpr std::string_view profile = {};\n}}\n",
                                  literal(mcpp::profile()));
    return write(file, text, "the build profile module") ? 0 : 1;
}

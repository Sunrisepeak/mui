    {"name": "design.variants.close", "description": "The board put away, nothing picked (the variants stay as branches)", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "design.variants again, or design.history.switch to a variant's branch", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {}, "required": []}},
    {"name": "design.film", "description": "The design's history as a film: a branch's commits from its first, each run in an unseen twin of the application as a design edit runs (its presentation) under a caption saying what the step was, drawn frame by frame — the frames (PNG) and a video description beside them, which `omui video render` (or `omui design film`) makes a WebM of. It follows the film's script (<branch>.film.omui.json, written beside the film when it is first made): each step's caption, time on screen, whether it is kept, and a camera on a node or a region, eased from the last", "effect": "reversible", "person": false, "delegated": false, "cost": "heavy", "undo": "delete the directory it names", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"branch": {"type": "string", "description": "whose commits (the one designed on when absent)"}, "out": {"type": "string", "description": "a file or directory path: where the frames and the description go (.omui/design/film/<branch>)"}, "fps": {"type": "integer", "description": "frames a second, 1 … 60 (30; the script's when it says)"}, "seconds": {"type": "number", "description": "a step's time on screen where the script does not say, 0.2 … 10 (1.5)"}, "script": {"type": "string", "description": "a file or directory path: the film's script, edited (.omui/design/film/<branch>.film.omui.json)"}}, "required": []}},
    {"name": "design.timeline", "description": "The design's history and its time in one picture, shown over the application (D-151): a lane for each branch, its commits by when they were made with their pictures; a commit pressed is seen, ◀ ▶ go through time, two compared. Answers the same as data; `at` sees a commit, `step` goes back or forward, `pictures` makes the latest commits' pictures in stand-ins", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "design.timeline at the commit seen before", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"show": {"type": "boolean", "description": "false puts it away (shown by default)"}, "at": {"type": "string", "description": "see this commit (an id, a tag, a branch, name~n)"}, "step": {"type": "integer", "description": "go this many commits back (negative) or forward in time"}, "pictures": {"type": "boolean", "description": "make pictures for the latest twelve commits without one"}}, "required": []}},
    {"name": "design.history", "description": "The design's history (D-151): the branch designed on, every branch and tag at its commit, a branch's commits newest first (message, who, when, the semantic tree's hash), and whether what runs now has changes not committed", "effect": "read", "person": false, "delegated": false, "cost": "bounded", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"branch": {"type": "string", "description": "whose commits (the one designed on when absent)"}, "limit": {"type": "integer", "description": "at most this many (50)"}}, "required": []}},
    {"name": "design.history.commit", "description": "Keeps the design as it runs now — every source's text — as a commit on the branch designed on, under .omui/design/ beside the application (not git's: omui design sync carries it there)", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "design.history.revert to the commit before", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"message": {"type": "string", "description": "what this state of the design is"}}, "required": ["message"]}},
    {"name": "design.history.branch", "description": "A new branch at a commit (the one designed on when absent), to try another way without losing this one; the design stays on its branch until design.history.switch", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "none: a branch is a name for a commit; it changes no design", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"name": {"type": "string", "description": "letters, digits, - _ . /"}, "at": {"type": "string", "description": "a branch, a tag, a commit (an id, or a name~n)"}}, "required": ["name"]}},
    {"name": "design.history.switch", "description": "Designs on another branch — or shows any commit — its texts running at once, each changed source shown changing as a design edit; changes not committed are refused unless `force` drops them. A commit seen leaves the branch where it was (`detached`)", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "design.history.switch back", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"to": {"type": "string", "description": "a branch, a tag or a commit (an id, or name~n)"}, "force": {"type": "boolean", "description": "drop changes not committed"}}, "required": ["to"]}},
    {"name": "design.history.revert", "description": "The design back as it was at a commit: its texts run at once, and kept as a new commit on the branch (nothing in the history is lost)", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "design.history.revert to the commit it made the step from", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"to": {"type": "string", "description": "a commit: an id, a tag, a branch, or name~n (HEAD~2: two commits back)"}}, "required": ["to"]}},
    {"name": "design.history.diff", "description": "What changed between two states of the design, source by source: the first line that differs, the lines before and after; from a commit (HEAD) to another, or to what runs now", "effect": "read", "person": false, "delegated": false, "cost": "bounded", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"from": {"type": "string", "description": "a commit (HEAD when absent)"}, "to": {"type": "string", "description": "a commit (what runs now when absent)"}}, "required": []}},
    {"name": "design.history.merge", "description": "Another branch's changes brought into this one, line by line from their common commit: each side's own changes taken, the same change once; if both changed the same lines nothing is merged and the sources are named. Merged, it runs at once and is a commit of both", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "design.history.revert to HEAD~1", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"from": {"type": "string", "description": "a branch (or a commit)"}}, "required": ["from"]}},
    {"name": "design.history.tag", "description": "A name for a commit (the last on the branch designed on when absent): a state to come back to or to show", "effect": "reversible", "person": false, "delegated": false, "cost": "instant", "undo": "none: a tag is a name for a commit; it changes no design", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"name": {"type": "string", "description": "letters, digits, - _ . /"}, "at": {"type": "string", "description": "a commit"}}, "required": ["name"]}},
    {"name": "design.expect", "description": "What the person expects, kept to check against: `say` in their words, and either `query` — the nodes it means (id, role, name, state, value …), `absent` when they must not be there — or `motion`: after an action, how a node moves (\"opens in 300–400 ms, springs at most 10%\"), measured in a twin. With neither, lists what is expected", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"say": {"type": "string", "description": "the expectation in the person's words"}, "query": {"description": "the nodes it means: {\"id\": \"save\", \"state\": \"disabled\"}"}, "absent": {"type": "boolean", "description": "they must not be there"}, "motion": {"description": "{act: {node, action, args?}, node, measure: height|width|x|y, within_ms: [least, most], overshoot: 0.1}"}}, "required": []}},
    {"name": "design.check", "description": "Each expectation read against the interface as it is now: holds or not, the nodes found with their name, value and states, and for a node that did not do what was expected, what the last press on it came to (the recorder)", "effect": "read", "person": false, "delegated": false, "cost": "bounded", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {}, "required": []}},
    {"name": "design.handover", "description": "Hands the floor to the person: they try the design; what they do from now, done, can be saved as a scenario (design.save_scenario)", "effect": "read", "person": false, "delegated": false, "cost": "instant", "undo": "", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {}, "required": []}},
    {"name": "design.save_scenario", "description": "What the person did since design.handover — their actions that were done, as semantic steps (node, action, arguments) — and what is expected, written as tests/<name>.scenario.omui.json beside the application: a demonstration as a test", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "delete the file it names", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"name": {"type": "string", "description": "the scenario's name, no path"}}, "required": ["name"]}},
    {"name": "design.replay", "description": "A saved scenario played again: each step done as it was, then what is expected checked — the demonstration as a test", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "the steps' own (ui.undo for reversible ones)", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {"name": {"type": "string", "description": "a scenario design.save_scenario saved"}}, "required": ["name"]}},
    {"name": "design.discard", "description": "Drops every edit not committed: each edited script runs its file's text again; the dropped texts are answered", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "design.edit with each text it answered", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {}, "required": []}},
    {"name": "design.commit", "description": "Writes every edit to its script's file (TypeScript stays the one source); each file's text before is answered", "effect": "reversible", "person": false, "delegated": false, "cost": "bounded", "undo": "design.edit with each text before, then design.commit", "undoable": false, "cancellable": false, "result": "json",
     "inputSchema": {"type": "object", "properties": {}, "required": []}}
  ],
  "tiers": []
}
)listing";

}  // namespace omui::agent::design

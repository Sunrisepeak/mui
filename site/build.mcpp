// The site's build program: its lens's contract becomes code; its content and
// the docs it shows are carried in the program; on the Web it is packed as a
// static page (the shape a Pages subpath serves as it is).
import std;
import mcpp;
import openmui.build.contracts;
import openmui.build.embed;
import openmui.build.toy;

int main() {
    const bool lens = openmui::build::components({.module = "openmui.site", .ns = "omui::site"});
    const bool content = openmui::build::embed({.module = "openmui.site", .ns = "omui::site::files", .dir = "content", .suffix = ".md", .tag = "content", .index = true});
    const bool en = openmui::build::embed({.module = "openmui.site", .ns = "omui::site::files", .dir = "../docs/en", .suffix = ".md", .tag = "en", .index = true});
    const bool zh = openmui::build::embed({.module = "openmui.site", .ns = "omui::site::files", .dir = "../docs/zh", .suffix = ".md", .tag = "zh", .index = true});
    // The reference run's frames as CI hashed them (the footer compares a browser's own with them).
    const bool frames = openmui::build::embed({.module = "openmui.site", .ns = "omui::site::files", .dir = "reference", .suffix = ".frames.omui.json", .tag = "frames"});
    // The fighters' pictures (the move list's stage draws them, 4 MB) come after the first frame: the fighting
    // game leaves them out of this program on the Web (its `art-later`), and the page fetches them.
    const char* fighting = mcpp::dep_dir("openmui.showcase.fighting");
    std::vector<openmui::build::later_files> later;
    if (fighting && *fighting) later.push_back({.dir = std::string(fighting) + "/fighters/art", .suffix = ".webp", .mount = "/later/fighters-art"});
    // The Chinese font cut down to the characters the site draws (2.7 of the 7.7 MB before its first frame):
    // its text, the docs it shows, the works it runs — and the common characters people type.
    const std::string here = mcpp::manifest_dir();
    std::vector<std::string> text{here + "/content", here + "/src", here + "/contract", here + "/../docs"};
    for (const char* dep : {"openmui.showcase.fighting", "openmui.showcase.style_gallery", "openmui.showcase.markdown_wall", "openmui.example.hello-im",
                            "openmui.ui.timeline", "openmui.ui.base", "openmui.ui.markdown"})
        if (const char* d = mcpp::dep_dir(dep); d && *d) text.push_back(std::string(d) + "/src");
    const bool page = openmui::build::dist_toy({.target = "omui-site", .title = "openmui", .fonts = {"Inter", "JetBrainsMono", "NotoSansSC"}, .background = "#0b0f16", .sdk = false,
                                                .later = std::move(later), .subsets = {{.font = "NotoSansSC", .text = std::move(text)}}});
    return lens && content && en && zh && frames && page ? 0 : 1;
}

[package]
name    = "{{project.name}}"
version = "0.1.0"

[package.metadata.openmui]
kind   = "theme"
themes = ["themes/*.theme.omui.toml"]

[targets.{{project.name}}]
kind = "lib"

[build]
sources = ["src/*.cppm", "src/*.cpp"]

[dependencies]
openmui.theme.default = "{{self.version}}"

# The rule that embeds themes/ in the package when this builds.
[build-dependencies]
openmui.build.embed = { version = "{{self.version}}", host-module = true }

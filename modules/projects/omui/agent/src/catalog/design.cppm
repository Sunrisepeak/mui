// Design a running application live: its sources and API, edits run at once with their state kept, expectations checked, the person's turn kept as a test, edits written back to the TypeScript sources.
inline constexpr std::array<mlibs::control::CatalogEntry, 32> catalog{{
    {{"design.begin", openas::Effect::reversible, false}, "Begins a design session with what it is for: the intent shown by your presence, the state it begins from kept as a commit, and every step after (each edit, set, insert, remove is a commit of its own) saying it", parameters_design_begin, "json", mlibs::control::Cost::bounded, "none: it only names what follows; design.history.revert takes the steps back", false, false, false, {}},
    {{"design.pace", openas::Effect::reversible, false}, "How fast the design steps are seen: their presentation's time scaled (0.25 … 4; 2 is twice as fast, 0.5 slower for a person to follow); the person's own motion level still holds", parameters_design_pace, "json", mlibs::control::Cost::instant, "design.pace with the pace it answered before", false, false, false, {}},
    {{"design.sources", openas::Effect::read, false}, "The scripts the application is made of: each one's path, language and the text it runs now (edited, or its file's), and the modules they import", {}, "json", mlibs::control::Cost::bounded, "", false, false, false, {}},
    {{"design.api", openas::Effect::read, false}, "How the scripts are written here: each language's API over this application's components — every builder with its properties (types, choices), handlers and actions, and the functions of the module — read before writing an edit", {}, "json", mlibs::control::Cost::bounded, "", false, false, false, {}},
    {{"design.locate", openas::Effect::read, false}, "Between a node and its source, either way: given `node`, the line of the script that built it (its path as design.sources names it, line, column, the line's text); given `path` and `line`, the nodes built on that line", parameters_design_locate, "json", mlibs::control::Cost::bounded, "", false, false, false, {}},
    {{"design.edit", openas::Effect::reversible, false}, "Runs new text as a script, at once, its state kept: the semantic changes it made and how long it took — or its problems, with their lines, and nothing changed. The edit stays until design.commit writes it to the file or design.discard drops it", parameters_design_edit, "json", mlibs::control::Cost::bounded, "design.edit with the text before, or design.discard", false, false, false, {}},
    {{"design.set", openas::Effect::reversible, false}, "Sets properties of a node by editing the builder call that built it (design.locate): each value written where the property is, or added to its object — the rest of the source as it was — then run as design.edit runs an edit: the semantic changes, and the lines it changed", parameters_design_set, "json", mlibs::control::Cost::bounded, "design.set with the values before, or design.discard", false, false, false, {}},
    {{"design.insert", openas::Effect::reversible, false}, "Adds an element, written as the script's language writes it, among the children of a node's builder call (at an index, or last), laid out as its siblings are; run as design.edit runs an edit", parameters_design_insert, "json", mlibs::control::Cost::bounded, "design.remove the node it added, or design.discard", false, false, false, {}},
    {{"design.remove", openas::Effect::reversible, false}, "Takes a node's builder call out of the list of children it is in (with its comma, and its line when it had one); run as design.edit runs an edit. A node built outside a list (a function's result, a condition) is refused: edit the code around it", parameters_design_remove, "json", mlibs::control::Cost::bounded, "design.insert its code again, or design.discard", false, false, false, {}},
    {{"design.preview", openas::Effect::reversible, false}, "Shows what edits would make, without making them: the application again in an unseen stand-in running the new texts, its picture laid half seen over what the person sees, with the semantic changes it would bring; design.preview.accept makes it a step, design.preview.reject lets it go", parameters_design_preview, "json", mlibs::control::Cost::heavy, "design.preview.reject", false, false, false, {}},
    {{"design.preview.accept", openas::Effect::reversible, false}, "The preview shown made real: its texts run at once, as a step of the design (a commit)", {}, "json", mlibs::control::Cost::bounded, "design.history.revert to HEAD~1", false, false, false, {}},
    {{"design.preview.reject", openas::Effect::reversible, false}, "The preview shown let go: nothing changed", {}, "json", mlibs::control::Cost::instant, "design.preview again", false, false, false, {}},
    {{"design.variants", openas::Effect::reversible, false}, "Several ways for a choice of taste (style, layout): each variant run in a stand-in, kept as a branch of the design's history (variant/<name>) with its picture, and laid out side by side on a board for the person to pick; nothing the person sees changes until one is picked", parameters_design_variants, "json", mlibs::control::Cost::heavy, "design.variants.close", false, false, false, {}},
    {{"design.variants.pick", openas::Effect::reversible, false}, "The variant chosen from the board: its texts run at once as a step of the design, and the board goes", parameters_design_variants_pick, "json", mlibs::control::Cost::bounded, "design.history.revert to HEAD~1", false, false, false, {}},
    {{"design.variants.close", openas::Effect::reversible, false}, "The board put away, nothing picked (the variants stay as branches)", {}, "json", mlibs::control::Cost::instant, "design.variants again, or design.history.switch to a variant's branch", false, false, false, {}},
    {{"design.film", openas::Effect::reversible, false}, "The design's history as a film: a branch's commits from its first, each run in an unseen twin of the application as a design edit runs (its presentation) under a caption saying what the step was, drawn frame by frame — the frames (PNG) and a video description beside them, which `omui video render` (or `omui design film`) makes a WebM of. It follows the film's script (<branch>.film.omui.json, written beside the film when it is first made): each step's caption, time on screen, whether it is kept, and a camera on a node or a region, eased from the last", parameters_design_film, "json", mlibs::control::Cost::heavy, "delete the directory it names", false, false, false, {}},
    {{"design.timeline", openas::Effect::reversible, false}, "The design's history and its time in one picture, shown over the application (D-151): a lane for each branch, its commits by when they were made with their pictures; a commit pressed is seen, ◀ ▶ go through time, two compared. Answers the same as data; `at` sees a commit, `step` goes back or forward, `pictures` makes the latest commits' pictures in stand-ins", parameters_design_timeline, "json", mlibs::control::Cost::bounded, "design.timeline at the commit seen before", false, false, false, {}},
    {{"design.history", openas::Effect::read, false}, "The design's history (D-151): the branch designed on, every branch and tag at its commit, a branch's commits newest first (message, who, when, the semantic tree's hash), and whether what runs now has changes not committed", parameters_design_history, "json", mlibs::control::Cost::bounded, "", false, false, false, {}},
    {{"design.history.commit", openas::Effect::reversible, false}, "Keeps the design as it runs now — every source's text — as a commit on the branch designed on, under .omui/design/ beside the application (not git's: omui design sync carries it there)", parameters_design_history_commit, "json", mlibs::control::Cost::bounded, "design.history.revert to the commit before", false, false, false, {}},
    {{"design.history.branch", openas::Effect::reversible, false}, "A new branch at a commit (the one designed on when absent), to try another way without losing this one; the design stays on its branch until design.history.switch", parameters_design_history_branch, "json", mlibs::control::Cost::instant, "none: a branch is a name for a commit; it changes no design", false, false, false, {}},
    {{"design.history.switch", openas::Effect::reversible, false}, "Designs on another branch — or shows any commit — its texts running at once, each changed source shown changing as a design edit; changes not committed are refused unless `force` drops them. A commit seen leaves the branch where it was (`detached`)", parameters_design_history_switch, "json", mlibs::control::Cost::bounded, "design.history.switch back", false, false, false, {}},
    {{"design.history.revert", openas::Effect::reversible, false}, "The design back as it was at a commit: its texts run at once, and kept as a new commit on the branch (nothing in the history is lost)", parameters_design_history_revert, "json", mlibs::control::Cost::bounded, "design.history.revert to the commit it made the step from", false, false, false, {}},
    {{"design.history.diff", openas::Effect::read, false}, "What changed between two states of the design, source by source: the first line that differs, the lines before and after; from a commit (HEAD) to another, or to what runs now", parameters_design_history_diff, "json", mlibs::control::Cost::bounded, "", false, false, false, {}},
    {{"design.history.merge", openas::Effect::reversible, false}, "Another branch's changes brought into this one, line by line from their common commit: each side's own changes taken, the same change once; if both changed the same lines nothing is merged and the sources are named. Merged, it runs at once and is a commit of both", parameters_design_history_merge, "json", mlibs::control::Cost::bounded, "design.history.revert to HEAD~1", false, false, false, {}},
    {{"design.history.tag", openas::Effect::reversible, false}, "A name for a commit (the last on the branch designed on when absent): a state to come back to or to show", parameters_design_history_tag, "json", mlibs::control::Cost::instant, "none: a tag is a name for a commit; it changes no design", false, false, false, {}},
    {{"design.expect", openas::Effect::read, false}, "What the person expects, kept to check against: `say` in their words, and either `query` — the nodes it means (id, role, name, state, value …), `absent` when they must not be there — or `motion`: after an action, how a node moves (\"opens in 300–400 ms, springs at most 10%\"), measured in a twin. With neither, lists what is expected", parameters_design_expect, "json", mlibs::control::Cost::instant, "", false, false, false, {}},
    {{"design.check", openas::Effect::read, false}, "Each expectation read against the interface as it is now: holds or not, the nodes found with their name, value and states, and for a node that did not do what was expected, what the last press on it came to (the recorder)", {}, "json", mlibs::control::Cost::bounded, "", false, false, false, {}},
    {{"design.handover", openas::Effect::read, false}, "Hands the floor to the person: they try the design; what they do from now, done, can be saved as a scenario (design.save_scenario)", {}, "json", mlibs::control::Cost::instant, "", false, false, false, {}},
    {{"design.save_scenario", openas::Effect::reversible, false}, "What the person did since design.handover — their actions that were done, as semantic steps (node, action, arguments) — and what is expected, written as tests/<name>.scenario.omui.json beside the application: a demonstration as a test", parameters_design_save_scenario, "json", mlibs::control::Cost::bounded, "delete the file it names", false, false, false, {}},
    {{"design.replay", openas::Effect::reversible, false}, "A saved scenario played again: each step done as it was, then what is expected checked — the demonstration as a test", parameters_design_replay, "json", mlibs::control::Cost::bounded, "the steps' own (ui.undo for reversible ones)", false, false, false, {}},
    {{"design.discard", openas::Effect::reversible, false}, "Drops every edit not committed: each edited script runs its file's text again; the dropped texts are answered", {}, "json", mlibs::control::Cost::bounded, "design.edit with each text it answered", false, false, false, {}},
    {{"design.commit", openas::Effect::reversible, false}, "Writes every edit to its script's file (TypeScript stays the one source); each file's text before is answered", {}, "json", mlibs::control::Cost::bounded, "design.edit with each text before, then design.commit", false, false, false, {}},
}};


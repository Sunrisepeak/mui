// Resolve the build profile once, in the build program. Runtime policy does
// not infer deployment mode from NDEBUG or accept a remote caller's claim.
import std;
import mcpp;
import mlibs.build.compose;

namespace {
std::string utf8(const std::filesystem::path& path) {
    const auto text = path.generic_u8string();
    return {reinterpret_cast<const char*>(text.data()), text.size()};
}
std::string literal(std::string_view text) {
    std::string out = "\"";
    for (char c : text) {
        switch (c) {
        case '\\':
            out += "\\\\";
            break;
        case '"':
            out += "\\\"";
            break;
        case '\n':
            out += "\\n";
            break;
        case '\r':
            out += "\\r";
            break;
        case '\t':
            out += "\\t";
            break;
        default:
            out += c;
            break;
        }
    }
    return out + '"';
}

// Writes a generated unit when its text changed, and hands it to the build.
bool write(const std::filesystem::path& file, const std::string& text, std::string_view what) {
    std::string old;
    if (std::ifstream input(file, std::ios::binary); input) old.assign(std::istreambuf_iterator<char>(input), {});
    if (old != text) {
        std::ofstream output(file, std::ios::binary | std::ios::trunc);
        output << text;
        if (!output) {
            std::println(std::cerr, "could not write {}", what);
            return false;
        }
    }
    mcpp::generated(utf8(file).c_str());
    return true;
}

} // namespace

int main() {
    mcpp::rerun_if_env_changed("MCPP_PROFILE");
    const auto file = std::filesystem::path(mcpp::out_dir()) / "omui" / "build_profile.cppm";
    std::error_code error;
    std::filesystem::create_directories(file.parent_path(), error);
    if (error) {
        std::println(std::cerr, "{}", error.message());
        return 1;
    }
    // What `omui::run` installs before a host is made (`hosting::install_services`), by this build's features and
    // target (mlibs.build.compose): a provider the unit does not name is not in the program. One row a capability.
    namespace compose = mlibs::build::compose;
    if (!compose::unit({.module = "omui",
                        .imports = {":shown"},
                        .function = "omui::hosting::install_services",
                        .providers = {{.feature = "shaping", .package = "mlibs.text.harfbuzz", .call = "mlibs::text::harfbuzz::install()"},
                                      {.feature = "agent", .package = "omui.agent", .call = "omui::agent::install()"},
                                      {.feature = "generate", .package = "omui.sdk", .import = "omui.generate", .call = "omui::generate::install()"},
                                      {.feature = "terminal",
                                       .package = "omui.host.terminal",
                                       .call = "omui::terminal::install()",
                                       .targets = compose::Targets::desktop},
                                      {.feature = "gpu",
                                       .package = "omui.host.sdl3.gpu",
                                       .call = "omui::host::sdl3::gpu::install()",
                                       .targets = compose::Targets::desktop},
                                      {.feature = "accessibility-bridge",
                                       .package = "omui.accessibility.bridge",
                                       .call = "omui::accessibility::bridge::install()",
                                       .targets = compose::Targets::desktop}}}))
        return 1;
    const auto text = std::format("// Generated by omui's build.mcpp.\nexport module omui:build_profile;\n\nimport std;\n\n"
                                  "export namespace omui::build {{\ninline constexpr std::string_view profile = {};\n}}\n",
                                  literal(mcpp::profile()));
    return write(file, text, "the build profile module") ? 0 : 1;
}

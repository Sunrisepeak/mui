[package]
name    = "{{project.name}}"
version = "0.1.0"

[package.metadata.openmui]
kind = "component"

[targets.{{project.name}}]
kind = "lib"

[build]
sources = ["src/*.cppm", "src/*.cpp"]

[dependencies]
"{{self.name}}" = "{{self.version}}"
# The kernel layer under mcpplibs.os, settled for the whole graph (the same
# pin as openmui's own root; lint rule `pins` keeps them equal).
mcpplibs.openkal = { git = "https://github.com/mcpplibs/openkal.git", branch = "openkal-0.17.0" }

# The rule that makes C++, stubs and a schema from contract/ when this builds.
[build-dependencies]
openmui.rules = { version = "{{self.version}}", host-module = true }

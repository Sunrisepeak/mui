// The pass's shader (shaders/mesh.slang) becomes the partition xrender.mesh.gpu:mesh_shaders, for the formats
// this build's target takes.
import std;
import mcpp;
import mlibs.shader.rules;

int main() { return mlibs::shader::rules::shaders({.module = "xrender.mesh.gpu", .ns = "xrender::mesh::gpu::shaders"}) ? 0 : 1; }

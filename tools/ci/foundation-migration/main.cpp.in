// The runner varies the import spelling and dependency keys independently
// of the library implementation. This is an external consumer, not a member.
import std;
{{imports}}

static_assert(std::same_as<mlibs::hash::Fnv1a, omui::hash::Fnv1a>);
static_assert(std::same_as<mlibs::math::SplitMix64, omui::math::SplitMix64>);
static_assert(std::same_as<mlibs::log::LogRecord, omui::LogRecord>);
static_assert(std::same_as<mlibs::trace::Span, omui::trace::Span>);
static_assert(std::same_as<mlibs::testing::Suite, omui::testing::Suite>);
static_assert(std::same_as<mlibs::testing::Hash, omui::hash::Fnv1a>);
static_assert(std::same_as<mlibs::geom::Rect, omui::geom::Rect>);
static_assert(std::same_as<mlibs::geom::Color, omui::geom::Color>);
struct ObjectTag;
static_assert(std::same_as<mlibs::memory::Handle<ObjectTag>, omui::Handle<ObjectTag>>);
static_assert(sizeof(mlibs::memory::Handle<ObjectTag>) == 8);
static_assert(mlibs::memory::Handle<ObjectTag>::from_bits(0x1234567889abcdefull).bits() == 0x1234567889abcdefull);
static_assert(std::same_as<mlibs::memory::SlotStorage<int>, omui::SlotStorage<int>>);
static_assert(std::same_as<mlibs::memory::FunctionRef<int(int)>, omui::FunctionRef<int(int)>>);
static_assert(std::same_as<mlibs::unicode::LineBreak, omui::unicode::LineBreak>);
static_assert(std::same_as<mlibs::fuzzy::Match, omui::fuzzy::Match>);
static_assert(std::same_as<mlibs::session::Session, omui::session::Session>);
static_assert(std::same_as<mlibs::pipeline::Pipeline, omui::pipeline::Pipeline>);
static_assert(std::same_as<mlibs::image::Image, omui::imageio::Image>);
static_assert(std::same_as<mlibs::rhi::Buffer, omui::rhi::Buffer>);
static_assert(std::same_as<mlibs::raster::Canvas, omui::raster::Canvas>);
static_assert(std::same_as<mlibs::shader::Program, omui::shader::Program>);
static_assert(std::same_as<mlibs::text::FontCollection, omui::typeset::FontCollection>);
static_assert(std::same_as<mlibs::layout::Engine, omui::layout::Engine>);
static_assert(std::same_as<mlibs::markdown::Document, omui::md::Document>);
static_assert(std::same_as<mlibs::i18n::Locale, omui::i18n::Locale>);
static_assert(mlibs::session::format_name == "openmui.session@0.1");

struct Counter { int value = 0; };
// Real client specialization through the legacy alias, consumed by new API.
template <> struct omui::pipeline::resource_type<Counter> {
    static constexpr std::string_view name = "consumer.Counter";
};
struct Add final : mlibs::pipeline::Stage {
    int amount;
    explicit Add(int n) : amount(n) {}
    std::vector<mlibs::pipeline::Port> reads() const override { return {omui::pipeline::port<Counter>("count")}; }
    std::vector<mlibs::pipeline::Port> writes() const override { return reads(); }
    std::expected<void, std::string> run(mlibs::pipeline::Context& context) override {
        auto* counter = context.resources.get<Counter>("count");
        if (!counter) return std::unexpected("missing count");
        counter->value += amount;
        return {};
    }
};

int main() {
    std::string content_pixel_hash;
    mlibs::testing::Suite suite("foundation namespace compatibility");
    suite.test("hash and math retain their values and one function identity", [] {
        mlibs::testing::check_eq(mlibs::hash::Fnv1a().text("foobar").hex(), std::string("85944171f73967e8"));
        omui::testing::check_eq(omui::hash::Fnv1a().text("foobar").hex(), std::string("85944171f73967e8"));
        mlibs::testing::check(&mlibs::hash::Fnv1a::hex == &omui::hash::Fnv1a::hex);
        mlibs::testing::check(&mlibs::math::det::sin == &omui::math::det::sin);
        omui::testing::check_bits(mlibs::math::det::sin(0.75), omui::math::det::sin(0.75));
        mlibs::testing::check_eq(mlibs::math::SplitMix64{1234567}.next(), omui::math::SplitMix64{1234567}.next());
    });
    suite.test("new and legacy log APIs share sink filter and history", [] {
        struct Sink { std::vector<std::string> messages; } sink;
        mlibs::log::set_log_history(0);
        omui::set_log_history(8);
        mlibs::log::set_log_sink([](void* user, const mlibs::log::LogRecord& record) {
            static_cast<Sink*>(user)->messages.emplace_back(record.message);
        }, &sink);
        mlibs::testing::check(omui::set_log_filter("migration=info,*=error").has_value());
        constexpr mlibs::log::Log current{"migration"};
        constexpr omui::Log legacy{"migration"};
        legacy.info("legacy {}", 1);
        current.info("current {}", 2);
        current.debug("filtered");
        mlibs::testing::check_eq(sink.messages.size(), std::size_t{2});
        const auto old_history = omui::recent_logs();
        const auto new_history = mlibs::log::recent_logs();
        mlibs::testing::check_eq(old_history.size(), std::size_t{2});
        mlibs::testing::check_eq(new_history.size(), old_history.size());
        if (old_history.size() == 2 && new_history.size() == 2) {
            omui::testing::check_eq(old_history[0].message, new_history[0].message);
            omui::testing::check_eq(old_history[1].message, new_history[1].message);
        }
        mlibs::testing::check(&mlibs::log::set_log_sink == &omui::set_log_sink);
        mlibs::testing::check(mlibs::log::set_log_filter("*=warning").has_value());
        omui::testing::check(!omui::log_enabled(omui::Level::info, "migration"));
        omui::set_log_sink(nullptr, nullptr);
        omui::set_log_history(0);
    });
    suite.test("new and legacy trace APIs share a recording", [] {
        mlibs::trace::start({64});
        mlibs::testing::check(omui::trace::enabled());
        {
            omui::trace::Span span("legacy span", "migration");
            mlibs::trace::mark("current mark", "migration");
        }
        const auto trace = omui::trace::stop();
        mlibs::testing::check(!mlibs::trace::enabled());
        mlibs::testing::check_eq(trace.events.size(), std::size_t{3});
        mlibs::testing::check_eq(trace.summary().size(), std::size_t{1});
        mlibs::testing::check(&mlibs::trace::start == &omui::trace::start);
        omui::trace::start({64});
        omui::trace::mark("legacy mark", "migration");
        mlibs::testing::check_eq(mlibs::trace::stop().events.size(), std::size_t{1});
    });
    suite.test("test helpers share the running suite state", [] {
        mlibs::testing::check(&mlibs::testing::failures == &omui::testing::failures);
        mlibs::testing::check(&mlibs::testing::check == &omui::testing::check);
        omui::testing::check_eq(mlibs::testing::failures(), 0);
    });
    suite.test("geometry crosses old and new entry points without conversion", [] {
        const omui::geom::Point p{2, 3};
        const auto transform = mlibs::geom::Affine::translate(7, 11) * omui::geom::Affine::scale(2, 4);
        mlibs::testing::check(transform.apply(p) == mlibs::geom::Point{11, 23});
        const mlibs::geom::Rect rect{-1.5f, 2.5f, 10, 20};
        mlibs::testing::check(omui::geom::snap(rect, 2) == mlibs::geom::PixelRect{-3, 5, 20, 40});
        mlibs::testing::check(rect.contains(omui::geom::Point{0, 3}) && !rect.contains(omui::geom::Point{8.5f, 3}));
        mlibs::testing::check(omui::geom::Color::parse("#1234") == mlibs::geom::Color::rgba8(17, 34, 51, 68));
    });
    suite.test("arena and slots keep one ownership and generation history", [] {
        mlibs::memory::Arena arena{128};
        omui::Arena& old_arena = arena;
        const auto text = old_arena.copy("same allocation");
        const auto allocations = arena.heap_allocations();
        arena.reset();
        const auto next = old_arena.copy("same allocation");
        mlibs::testing::check(text.data() == next.data() && arena.heap_allocations() == allocations);
        mlibs::testing::check(&mlibs::memory::Arena::reset == &omui::Arena::reset);
        mlibs::memory::SlotStorage<int> storage{2};
        omui::SlotStorage<int>& old_storage = storage;
        const auto key = storage.insert(17);
        mlibs::testing::check(key.has_value());
        if (!key) return;
        mlibs::testing::check(old_storage.get(*key) && *old_storage.get(*key) == 17);
        mlibs::testing::check(old_storage.erase(*key) && !storage.contains(*key));
        const auto replacement = old_storage.insert(23);
        mlibs::testing::check(replacement && replacement->index == key->index && replacement->generation == key->generation + 1);
        auto add = [](int value) { return value + 2; };
        mlibs::memory::FunctionRef<int(int)> fn{add};
        const omui::FunctionRef<int(int)>& old_fn = fn;
        mlibs::testing::check_eq(old_fn(40), 42);
    });
    suite.test("Unicode properties and grapheme navigation retain their owner", [] {
        const std::string text = "a\u0301👨‍👩‍👧‍👦中";
        mlibs::testing::check_eq(mlibs::unicode::grapheme_count(text), std::size_t{3});
        mlibs::testing::check(omui::unicode::grapheme_boundaries(text) == std::vector<std::size_t>{0, 3, 28, 31});
        mlibs::testing::check(mlibs::unicode::grapheme_boundaries(text) == omui::unicode::grapheme_boundaries(text));
        mlibs::testing::check_eq(omui::unicode::upper("Straße"), std::string("STRASSE"));
        mlibs::testing::check(&mlibs::unicode::decode == &omui::unicode::decode);
        mlibs::testing::check(&mlibs::unicode::grapheme_boundaries == &omui::unicode::grapheme_boundaries);
    });
    suite.test("fuzzy consumes the canonical Unicode library across legacy calls", [] {
        const std::vector<std::string> choices{"src/main.cpp", "src/memory.cppm", "README.md", "中文文件"};
        const auto current = mlibs::fuzzy::rank("sm", choices, 10);
        const auto old = omui::fuzzy::rank("sm", choices, 10);
        mlibs::testing::check(!current.empty() && current.size() == old.size());
        if (current.size() != old.size()) return;
        for (std::size_t i = 0; i < current.size(); ++i) {
            mlibs::testing::check(current[i].index == old[i].index && current[i].score == old[i].score && current[i].positions == old[i].positions);
        }
        const auto chinese = omui::fuzzy::match("中文", "中文文件");
        mlibs::testing::check(chinese && chinese->positions == std::vector<std::uint32_t>{0, 1});
        mlibs::testing::check(&mlibs::fuzzy::match == &omui::fuzzy::match);
    });
    suite.test("session data and files cross new and legacy APIs byte-identically", [] {
        mlibs::session::Session recording;
        recording.header.app = "org.example.namespace-consumer";
        recording.header.seed = 42;
        mlibs::testing::check(recording.add(1, "act", R"({"node":"main/保存","actor":"agent:qa"})").has_value());
        omui::session::Session& old = recording;
        mlibs::testing::check(old.add(0.25, "frame", R"({"index":1})").has_value());
        const auto wire = old.ndjson();
        mlibs::testing::check(wire.starts_with(R"({"format":"openmui.session@0.1",)"));
        auto parsed = omui::session::Session::parse(wire);
        mlibs::testing::check(parsed && parsed->ndjson() == wire && parsed->seek(0.5) == 1);
        const auto file = mlibs::testing::scratch_dir("namespace") / std::filesystem::path(u8"会话.session.omui.jsonl");
        mlibs::testing::check(recording.save(file).has_value());
        auto loaded = omui::session::Session::load(file);
        mlibs::testing::check(loaded && loaded->ndjson() == wire && loaded->header.seed == 42);
        mlibs::testing::check(&mlibs::session::Session::parse == &omui::session::Session::parse);
    });
    suite.test("one pipeline owns legacy resources replacement and shared traces", [] {
        omui::pipeline::Registry plugins;
        mlibs::testing::check(plugins.add({.name = "consumer.add", .trace_category = "consumer.pipeline",
                                         .cost = mlibs::pipeline::Cost{.cpu_us = 100}},
            [](const mlibs::pipeline::Config& config) -> std::expected<std::unique_ptr<mlibs::pipeline::Stage>, std::string> {
                return std::make_unique<Add>(static_cast<int>(config.integer("amount", 2)));
            }).has_value());
        const std::array inputs{omui::pipeline::port<Counter>("count")};
        auto pipeline = mlibs::pipeline::Pipeline::build({"consumer", {{"add", "consumer.add", {}, {}}}}, plugins, inputs);
        mlibs::testing::check(pipeline.has_value());
        if (!pipeline) return;
        Counter counter{1};
        omui::pipeline::Resources resources;
        resources.put("count", &counter);
        omui::pipeline::Pipeline& old = *pipeline;
        mlibs::trace::start({64});
        mlibs::testing::check(old.run(resources).has_value());
        const auto trace = omui::trace::stop();
        mlibs::testing::check(counter.value == 3 && trace.summary().size() == 1);
        mlibs::testing::check(!old.replace("add", "missing.plugin", {}, plugins));
        mlibs::testing::check(pipeline->run(resources).has_value() && counter.value == 5);
        mlibs::testing::check(pipeline->replace("add", "consumer.add", {{"amount", std::int64_t{7}}}, plugins).has_value());
        mlibs::testing::check(old.run(resources).has_value() && counter.value == 12);
        mlibs::testing::check(old.timings().size() == 1 && old.order() == std::vector<std::string>{"add"});
        mlibs::testing::check(&mlibs::pipeline::Pipeline::build == &omui::pipeline::Pipeline::build);
    });
    suite.test("PNG and lossless WebP cross old and new codecs without pixel changes", [] {
        const mlibs::image::Image picture{2, 2, mlibs::image::Alpha::straight,
            {255, 0, 0, 255, 0, 255, 0, 128, 0, 0, 255, 255, 23, 42, 67, 0}};
        const auto png = mlibs::image::encode_png(omui::imageio::view(picture));
        mlibs::testing::check(png.has_value());
        if (!png) return;
        const auto decoded = omui::imageio::decode_png(*png);
        mlibs::testing::check(decoded && decoded->rgba == picture.rgba);
        const auto webp = omui::imageio::encode_webp(mlibs::image::view(picture), {.lossless = true});
        mlibs::testing::check(webp.has_value());
        if (!webp) return;
        const auto back = mlibs::image::decode(*webp);
        mlibs::testing::check(back && back->rgba == picture.rgba);
        mlibs::testing::check(&mlibs::image::decode_png == &omui::imageio::decode_png);
        mlibs::testing::check(&mlibs::image::encode_webp == &omui::imageio::encode_webp);
    });
    suite.test("animated WebP uses the same mux demux and complete frame pixels", [] {
        const mlibs::image::Image a{2, 2, mlibs::image::Alpha::straight,
            {255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 20, 40, 60, 255}};
        auto b = a;
        b.rgba[0] = 0;
        b.rgba[2] = 255;
        const std::array frames{mlibs::image::view(a), omui::imageio::view(b)};
        const auto encoded = mlibs::image::encode_animated_webp(frames, {.delay_num = 1, .delay_den = 10, .loops = 3, .lossless = true});
        mlibs::testing::check(encoded.has_value());
        if (!encoded) return;
        const auto decoded = omui::imageio::decode_animated_webp(*encoded);
        mlibs::testing::check(decoded && decoded->loops == 3 && decoded->frames.size() == 2);
        if (!decoded || decoded->frames.size() != 2) return;
        mlibs::testing::check(decoded->frames[0].image.rgba == a.rgba && decoded->frames[1].image.rgba == b.rgba);
        mlibs::testing::check(decoded->frames[0].delay_ms == 100 && decoded->frames[1].delay_ms == 100);
    });
    suite.test("RHI command ownership and wire words cross legacy and canonical APIs", [] {
        mlibs::rhi::CommandList list;
        omui::rhi::CommandList& old = list;
        old.set_scissor({2, 3, 40, 50});
        list.draw(6, 2);
        std::vector<std::uint32_t> a, b;
        mlibs::rhi::wire::encode(old, a);
        omui::rhi::wire::encode(list, b);
        mlibs::testing::check(!a.empty() && a == b);
        if (!a.empty()) mlibs::testing::check(mlibs::rhi::wire::op(a[0]) == omui::rhi::wire::Op::set_scissor);
        mlibs::testing::check(&mlibs::rhi::CommandList::hash == &omui::rhi::CommandList::hash);
        const auto buffer = mlibs::rhi::Buffer::from_bits(0x1234567800000003ull);
        const omui::rhi::Buffer legacy = buffer;
        mlibs::testing::check(legacy.bits() == 0x1234567800000003ull);
    });
    suite.test("one raster canvas retains clips pixels and PNG output across names", [] {
        mlibs::raster::Surface surface{16, 16};
        mlibs::raster::Canvas canvas{surface};
        omui::raster::Canvas& old = canvas;
        old.push_clip_rect({3, 2, 5, 6});
        canvas.fill_rect({0, 0, 16, 16}, mlibs::raster::Paint::solid(mlibs::geom::Color{1, 0, 0, 1}));
        old.pop_clip();
        mlibs::testing::check(surface.at(3, 2) == omui::raster::Rgba8{255, 0, 0, 255});
        mlibs::testing::check(surface.at(2, 2) == mlibs::raster::Rgba8{} && surface.at(8, 8) == mlibs::raster::Rgba8{});
        const mlibs::image::View pixels{surface.bytes().data(), 16, 16, 64, mlibs::image::Alpha::premultiplied};
        const auto png = omui::imageio::encode_png(pixels);
        mlibs::testing::check(png.has_value());
        if (!png) return;
        const auto decoded = mlibs::image::decode_png(*png);
        mlibs::testing::check(decoded && std::ranges::equal(decoded->rgba, surface.bytes()));
        mlibs::testing::check(&mlibs::raster::Surface::hash == &omui::raster::Surface::hash);
    });
    suite.test("actual Slang compilation emits canonical RHI constants through either API", [] {
        const auto program = mlibs::shader::compile("consumer.slang",
            {.formats = mlibs::rhi::formats({mlibs::rhi::ShaderFormat::spirv, mlibs::rhi::ShaderFormat::wgsl, mlibs::rhi::ShaderFormat::essl})});
        mlibs::testing::check(program.has_value(), program ? "" : program.error());
        if (!program) return;
        const auto* vertex = program->entry("consumer_vs");
        const auto* fragment = program->entry("consumer_fs");
        mlibs::testing::check(vertex && fragment && vertex->code.size() == 3 && fragment->code.size() == 3);
        const mlibs::shader::EmitOptions options{.module = "consumer.graphics", .partition = "compiled", .ns = "consumer::graphics"};
        const auto code = omui::shader::emit_cpp(*program, options);
        mlibs::testing::check(code == mlibs::shader::emit_cpp(*program, options));
        mlibs::testing::check(code.contains("import mlibs.rhi;") && code.contains("mlibs::rhi::ShaderDesc consumer_fs"));
        mlibs::testing::check(&mlibs::shader::emit_cpp == &omui::shader::emit_cpp);
    });
    suite.test("one layout tree reflows across viewport sizes through either API", [] {
        mlibs::layout::Engine engine;
        omui::layout::Engine& old = engine;
        mlibs::layout::Style row;
        row.wrap = mlibs::layout::Wrap::wrap;
        row.column_gap = 4;
        const auto root = engine.create(row);
        std::array<mlibs::layout::NodeId, 3> children;
        for (auto& child : children) {
            child = old.create({.width = omui::layout::pt(60), .height = omui::layout::pt(24), .shrink = 0});
            engine.append(root, child);
        }
        old.compute(root, {132, 100});
        mlibs::testing::check_eq(engine.frame(children[1]).x, 64.0f);
        mlibs::testing::check_eq(engine.frame(children[2]).y, 24.0f);
        engine.compute(root, {64, 100});
        mlibs::testing::check_eq(old.frame(children[1]).y, 24.0f);
        mlibs::testing::check_eq(old.frame(children[2]).y, 48.0f);
        mlibs::testing::check(&mlibs::layout::Engine::compute == &omui::layout::Engine::compute);
    });
    suite.test("Markdown stream and parsed document share semantic content and HTML", [] {
        const std::string first = "# Title\n\n";
        const std::string second = "**中文** and [a link](https://example.com).\n";
        mlibs::markdown::Stream stream;
        stream.append(first);
        omui::md::Stream& old = stream;
        old.append(second);
        const auto parsed = omui::md::parse(first + second);
        const auto html = mlibs::markdown::to_html(parsed);
        mlibs::testing::check(html == omui::md::to_html(stream.document()));
        mlibs::testing::check(html.contains("<strong>中文</strong>"));
        mlibs::testing::check(parsed.root.children[0].anchor == "title");
        mlibs::testing::check(&mlibs::markdown::parse == &omui::md::parse);
    });
    suite.test("locale parsing and likely subtags share types and operations", [] {
        const auto locale = mlibs::i18n::Locale::parse("zh_HK.UTF-8");
        mlibs::testing::check(locale.has_value());
        if (!locale) return;
        const omui::i18n::Locale old = *locale;
        mlibs::testing::check(old.tag() == "zh-HK");
        mlibs::i18n::LikelySubtags likely;
        likely.add("zh-HK", "zh-Hant-HK");
        const omui::i18n::LikelySubtags& shared = likely;
        mlibs::testing::check(shared.maximize(old).tag() == "zh-Hant-HK");
        mlibs::testing::check(&mlibs::i18n::Locale::parse == &omui::i18n::Locale::parse);
    });
    suite.test("embedded CLDR packs have one cache and retain real localized output", [] {
        mlibs::testing::check(mlibs::i18n::cldr::data("zh") == omui::i18n::cldr::data("zh"));
        mlibs::testing::check(mlibs::i18n::cldr::data("zh") != nullptr);
        mlibs::testing::check(&mlibs::i18n::cldr::likely() == &omui::i18n::cldr::likely());
        mlibs::i18n::Library library;
        omui::i18n::cldr::add_to(library);
        const std::array requested{*mlibs::i18n::Locale::parse("zh-HK")};
        omui::i18n::Translator translator(library, requested, *mlibs::i18n::Locale::parse("en"));
        mlibs::testing::check(translator.formatter().number(123456.0, {.style = mlibs::i18n::NumberOptions::Style::compact_short}).text == "12萬");
        mlibs::testing::check(translator.formatter().date({2026, 10, 28}, mlibs::i18n::DateStyle::full) == "2026年10月28日 星期三");
    });
    suite.test("mixed-script text shapes and renders through one font collection and renderer", [&] {
        mlibs::text::FontCollection fonts;
        const auto loaded = fonts.add_defaults({{fonts_directory}});
        mlibs::testing::check(loaded.has_value(), loaded ? "" : loaded.error());
        if (!loaded) return;
        mlibs::testing::check(omui::typeset::FontCollection::alive(fonts.id()));
        const std::array<std::string, 1> family{"Inter"};
        mlibs::testing::check(fonts.covers(fonts.select(family, U"中"), U'中'));
        mlibs::testing::check(fonts.covers(fonts.select(family, U"ب"), U'ب'));
        mlibs::text::ParagraphStyle style;
        style.style.size = 24;
        omui::typeset::Paragraph paragraph(fonts, "omui 中文 العربية", style);
        paragraph.layout(280);
        mlibs::testing::check(!paragraph.lines().empty() && paragraph.size().height > 0);
        omui::render::DisplayList list;
        paragraph.paint(list, {8, 8});
        mlibs::text::GlyphCache glyphs(fonts);
        mlibs::raster::Surface pixels(320, 100);
        omui::render::CpuRenderer renderer;
        (void)renderer.render(list, pixels, {nullptr, &glyphs}, {.background = mlibs::geom::Color::white()});
        std::size_t ink = 0;
        for (int y = 0; y < pixels.height(); ++y)
            for (int x = 0; x < pixels.width(); ++x)
                if (pixels.at(x, y).r < 100) ++ink;
        mlibs::testing::check(ink > 200, "actual glyph coverage");
        content_pixel_hash = std::format("{:016x}", pixels.hash());
        const mlibs::image::View view{pixels.bytes().data(), 320, 100, 1280, mlibs::image::Alpha::premultiplied};
        const auto png = mlibs::image::encode_png(view);
        mlibs::testing::check(png.has_value());
        if (!png) return;
        std::ofstream output("content.png", std::ios::binary);
        output.write(reinterpret_cast<const char*>(png->data()), static_cast<std::streamsize>(png->size()));
        mlibs::testing::check(output.good());
    });
    const int result = suite.run();
    std::string identities;
    for (std::string_view identity : std::array{ {{lock_identities}} }) {
        if (!identities.empty()) identities += ',';
        identities += std::format("\"{}\":\"fnv1a:{}\"", identity, mlibs::hash::Fnv1a().text(identity).hex());
    }
    std::println("{{\"kind\":\"mlibs.namespace-consumer\",\"ok\":{},\"cases\":20,\"content_pixel_hash\":\"{}\",\"identity_hashes\":{{{}}}}}", result == 0, content_pixel_hash, identities);
    return result;
}

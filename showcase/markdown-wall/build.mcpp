// The wall's behaviours (behaviors/*.behavior.omui.toml) embedded in the
// program: partitions openmui.showcase.markdown_wall:<name>_behavior, loaded when it starts.
import std;
import mcpp;
import omui.build.embed;

int main() { return openmui::build::behaviors({.module = "omui.showcase.markdown_wall", .ns = "omui::wall"}) ? 0 : 1; }

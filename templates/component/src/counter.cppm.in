// The behaviour of `counter`. The generated base holds its props, dispatches
// its actions (a missing one does not compile) and emits its events.
export module {{project.name}}:counter;

import std;
import openmui;
import :counter_contract;

export namespace {{project.name}} {

class Counter : public CounterContract<Counter> {
public:
    omui::Size measure(omui::MeasureContext&, std::optional<float>, std::optional<float>, omui::layout::Available,
                       omui::layout::Available) {
        return {64, 32};
    }
    void paint(omui::PaintContext& ctx) const {
        ctx.list.fill_round_rect({0, 0, ctx.size.width, ctx.size.height}, omui::CornerRadii::all(8),
                                 omui::render::Paint::solid(ctx.theme.color("surface_variant")));
    }
    void semantics(omui::SemanticsContext&, omui::spec::SemanticNode& node) const {
        if (node.name.empty()) node.name = props.label;
        node.value = omui::Value(props.value);
    }
    omui::ActResult increment(omui::ActContext&) { return set(props.value + props.step); }
    omui::ActResult decrement(omui::ActContext&) { return set(props.value - props.step); }

private:
    omui::ActResult set(std::int32_t v) {
        write_value(v);
        emit_changed(v);
        services().invalidate_semantics(node());
        return omui::ActResult::done(omui::Value(v));
    }
};

}  // namespace {{project.name}}

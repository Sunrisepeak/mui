// Resolve the build profile once, in the build program. Runtime policy does
// not infer deployment mode from NDEBUG or accept a remote caller's claim.
import std;
import mcpp;

namespace {
std::string utf8(const std::filesystem::path& path) {
    const auto text = path.generic_u8string();
    return {reinterpret_cast<const char*>(text.data()), text.size()};
}
std::string literal(std::string_view text) {
    std::string out = "\"";
    for (char c : text) {
        switch (c) {
        case '\\':
            out += "\\\\";
            break;
        case '"':
            out += "\\\"";
            break;
        case '\n':
            out += "\\n";
            break;
        case '\r':
            out += "\\r";
            break;
        case '\t':
            out += "\\t";
            break;
        default:
            out += c;
            break;
        }
    }
    return out + '"';
}
} // namespace

int main() {
    mcpp::rerun_if_env_changed("MCPP_PROFILE");
    const auto file = std::filesystem::path(mcpp::out_dir()) / "omui" / "build_profile.cppm";
    std::error_code error;
    std::filesystem::create_directories(file.parent_path(), error);
    if (error) {
        std::println(std::cerr, "{}", error.message());
        return 1;
    }
    const auto text = std::format("// Generated by omui's build.mcpp.\nexport module omui:build_profile;\n\nimport std;\n\n"
                                  "export namespace omui::build {{\ninline constexpr std::string_view profile = {};\n}}\n",
                                  literal(mcpp::profile()));
    std::string old;
    if (std::ifstream input(file, std::ios::binary); input) old.assign(std::istreambuf_iterator<char>(input), {});
    if (old != text) {
        std::ofstream output(file, std::ios::binary | std::ios::trunc);
        output << text;
        if (!output) {
            std::println(std::cerr, "could not write the build profile module");
            return 1;
        }
    }
    mcpp::generated(utf8(file).c_str());
    return 0;
}

// The package's own components (contract/*.contract.omui.toml: badge, avatar,
// skeleton, card, accordion, toast, popover, breadcrumb, pagination, number
// input) become code when it builds; the Core components' (spec §11) are
// committed in src/generated, made from spec/registry.
import std;
import mcpp;
import omui.build.contracts;

// The window frame's (contract/window/) and liquid glass's (contract/liquid_glass/) are their modules' own.
int main() {
    const bool base = omui::build::components({.module = "omui.ui.base", .ns = "omui"});
    const bool window = omui::build::components({.module = "omui.ui.window", .ns = "omui", .contracts = "contract/window"});
    const bool glass = omui::build::components({.module = "omui.ui.liquid_glass", .ns = "omui", .contracts = "contract/liquid_glass"});
    return base && window && glass ? 0 : 1;
}

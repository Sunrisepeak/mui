// The GPU backend's shaders become partitions of openmui.render, for the
// formats this build's target takes: shaders/<name>.slang (drawing,
// compositing) and effects/<name>.slang (the built-in effects' GPU paths,
// written against the effect template in effects/lib) as :<name>_shaders.
import std;
import mcpp;
import mlibs.shader.rules;

int main() {
    // ui.slang and material.slang produce separate resource layouts/partitions;
    // both import the same resource-free types and shading functions.
    const bool drawing = mlibs::shader::rules::shaders({.module = "xrender.vector.api", .ns = "xrender::shaders", .includes = {"shaders/lib"}});
    const bool effects = mlibs::shader::rules::shaders(
        {.module = "xrender.vector.api", .ns = "xrender::shaders", .shaders = "effects", .includes = {"effects/lib"}});
    return drawing && effects ? 0 : 1;
}

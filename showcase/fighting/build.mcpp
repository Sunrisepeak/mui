// The stage's contract becomes code (openmui.rules), and the fighters' files —
// what they do, how they look, their baked hurtboxes — are carried in the
// program (gongfu.rules).
import std;
import mcpp;
import openmui.rules;
import gongfu.rules;

int main() {
    const bool stage = openmui::rules::components({.module = "openmui.showcase.fighting", .ns = "omui::fighting"});
    // The fighters, their looks and baked hurtboxes; a stale bake fails the build.
    const bool fighters = gongfu::rules::fighters({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files"});
    // What the fight sounds like (openmui.audio).
    const bool sounds = openmui::rules::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "sounds",
                                               .suffix = ".sound.omui.toml", .tag = "sound"});
    // The stages' art (gongfu.present2d's stage files).
    const bool stages = openmui::rules::embed({.module = "openmui.showcase.fighting", .ns = "omui::fighting::files", .dir = "stages",
                                               .suffix = ".stage.gongfu.toml", .tag = "stage"});
    return stage && fighters && sounds && stages ? 0 : 1;
}

enum class ButtonVariant : std::uint8_t { primary, secondary, ghost, danger };

[[nodiscard]] constexpr std::string_view name(ButtonVariant v) noexcept {
    switch (v) {
        case ButtonVariant::primary: return "primary";
        case ButtonVariant::secondary: return "secondary";
        case ButtonVariant::ghost: return "ghost";
        case ButtonVariant::danger: return "danger";
    }
    return {};
}

[[nodiscard]] constexpr std::optional<ButtonVariant> parse_button_variant(std::string_view text) noexcept {
    if (text == "primary") return ButtonVariant::primary;
    if (text == "secondary") return ButtonVariant::secondary;
    if (text == "ghost") return ButtonVariant::ghost;
    if (text == "danger") return ButtonVariant::danger;
    return std::nullopt;
}

}  // namespace omui


// The slangc mcpp provisioned (xim:slang, [xlings.workspace]), as a constant
// of the library: find_slangc() falls back to it after OMUI_SLANGC, so tests
// and omui-slang run without slangc on PATH. An override that names a
// program wins over the payload's layout.
import std;
import mcpp;

namespace {

std::string utf8(const std::filesystem::path& p) {
    const std::u8string u = p.generic_u8string();
    return std::string(reinterpret_cast<const char*>(u.data()), u.size());
}

std::string provisioned() {
    if (const char* program = mcpp::xpkg_program("xim", "slang"); program && *program) return program;
    const std::string dir = mcpp::xpkg_dir("xim", "slang");
    if (dir.empty()) return {};
    for (const char* name : {"slangc", "slangc.exe"}) {
        const std::filesystem::path p = std::filesystem::path(dir) / "bin" / name;
        std::error_code ec;
        if (std::filesystem::is_regular_file(p, ec)) return utf8(p);
    }
    return {};
}

}  // namespace

int main() {
    const std::string slangc = provisioned();
    if (slangc.empty())
        mcpp::warning("openmui.slang: no slangc was provisioned (xim:slang); find_slangc() will look at OMUI_SLANGC and PATH");
    const std::filesystem::path out = std::filesystem::path(mcpp::out_dir()) / "openmui" / "slang_provisioned.cppm";
    std::error_code ec;
    std::filesystem::create_directories(out.parent_path(), ec);
    const std::string text = std::format(
        "// Generated by openmui.slang's build.mcpp: the slangc mcpp provisioned.\n"
        "export module openmui.slang:provisioned;\n\nimport std;\n\n"
        "export namespace omui::slang {{\ninline constexpr std::string_view provisioned_slangc = R\"slangc({})slangc\";\n}}\n",
        slangc);
    std::string old;
    if (std::ifstream in(out, std::ios::binary); in) old.assign(std::istreambuf_iterator<char>(in), {});
    if (old != text) std::ofstream(out, std::ios::binary | std::ios::trunc) << text;
    mcpp::generated(utf8(out).c_str());
    return 0;
}

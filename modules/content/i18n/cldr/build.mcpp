// The locale packs (data/*.locale.omui.json) embedded in the program:
// partitions mlibs.i18n.cldr.api:<id>_locale.
import std;
import mcpp;
import omui.build.embed;

int main() {
    return omui::build::embed({.module = "mlibs.i18n.cldr.api", .ns = "mlibs::i18n::cldr", .dir = "data", .suffix = ".locale.omui.json", .tag = "locale"})
               ? 0
               : 1;
}

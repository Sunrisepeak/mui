[[nodiscard]] constexpr std::uint8_t lookup(const auto& table, char32_t cp) noexcept {
    if (cp >= 0x110000) cp = 0xFFFD;
    const std::size_t block = table.top[cp >> 9];
    const std::size_t leaf = table.middle[block * 32 + ((cp >> 4) & 31)];
    return table.leaves[leaf * 16 + (cp & 15)];
}


// The site on the Web, a static page (`omui build --web`, D-236): the
// player, its fonts, the page's own files (its manifest, its config, app/ and
// its design's replay) in the player's file system before it starts, and its
// first screen as a document a reader and a search engine read before it runs
// — the file below, which `omui build --web` writes first by running it natively.
import std;
import mcpp;
import omui.build.toy;
import omui.build.closure;

int main() {
    // Its fonts cut down to what it draws before their full faces are asked for: the page's own text (app/), ASCII
    // (an agent's name, a platform) and the shared symbols; a character neither has (a name in another script)
    // fetches the full face then, as the site's does (RC2.9).
    const std::string here = mcpp::manifest_dir();
    std::string ascii;
    for (int c = 32; c < 127; ++c) ascii += static_cast<char>(c);
    const std::string latin = ascii + " áéíóúàèìòùäëïöüÁÉÍÓÚÀÈÌÒÙÄËÏÖÜÑñçÇß°·×−–—‘’“”…→←✓";
    // The components it carries are the ones its scripts and its design's steps create by name (B7b).
    const bool components = omui::build::closure({.files = {"app", "design/main.replay.xdef.json"}});
    const bool page = omui::build::dist_toy({.target = "omui-site", .title = "omui", .fonts = {"Inter", "JetBrainsMono"}, .background = "#faf9f6",
                                             .sdk = false,
                                             .font_initial = {{"Inter", latin}, {"JetBrainsMono", ascii + "·…"}},
                                             .font_initial_text = {{.font = "Inter", .text = {here + "/app"}}, {.font = "JetBrainsMono", .text = {here + "/app"}}},
                                             .fonts_on_demand = {"Inter", "JetBrainsMono"},
                                             .static_html = "target/web/omui-site.static.html", .lang = "en",
                                             .description = "A UI framework where one semantic tree drives the pixels, the motion, accessibility, agents and tests. "
                                                            "An agent made this page in Live Design; press the key to watch it.",
                                             .files = {"mcpp.toml", "omui.config.ts", "app", "design/main.replay.xdef.json"}});
    return components && page ? 0 : 1;
}
